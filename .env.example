# ── Backend CRM de Algoritmo Digital ──────────────────────────────────
CRM_BASE_URL=https://tu-crm.ejemplo.com

# ── Modo stdio (local) ────────────────────────────────────────────────
# Opcion A: token JWT ya emitido por el CRM (recomendado)
CRM_TOKEN=
# Opcion B: usuario y clave del panel (el MCP hace login y cachea el JWT)
CRM_USERNAME=
CRM_PASSWORD=
# Cuenta de ML por defecto (id numerico de ml_cuentas). Vacio = todas.
ML_CUENTA=

# ── Modo HTTP remoto (conector con OAuth) ─────────────────────────────
PORT=8787
PUBLIC_URL=https://mcp.algoritmodigital.com.ar
OAUTH_SIGNING_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
# Permitir herramientas de escritura (responder preguntas, editar items, sync)
ALLOW_WRITE=1
