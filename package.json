{
  "name": "@algoritmodigital/mcp-mercadolibre",
  "version": "1.0.0",
  "description": "Servidor MCP de MercadoLibre para Claude AI: consulta ventas, rentabilidad real, stock, publicaciones, preguntas, reclamos, Product Ads y precios de la competencia en lenguaje natural. 32 herramientas, stdio y HTTP con OAuth 2.1.",
  "type": "module",
  "license": "MIT",
  "author": "Algoritmo Digital",
  "homepage": "https://algoritmodigital.com.ar",
  "bin": {
    "mcp-mercadolibre": "src/stdio.js",
    "mcp-mercadolibre-http": "src/http.js"
  },
  "files": [
    "src",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/stdio.js",
    "start:http": "node src/http.js",
    "inspect": "npx @modelcontextprotocol/inspector node src/stdio.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mercadolibre",
    "meli",
    "mercado-libre",
    "claude",
    "claude-ai",
    "claude-desktop",
    "claude-code",
    "anthropic",
    "ecommerce",
    "marketplace",
    "seller",
    "vendedor",
    "ventas",
    "stock",
    "rentabilidad",
    "product-ads",
    "oauth2",
    "argentina",
    "latam",
    "algoritmodigital"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  }
}
